    ${monster.status
      ? `<span class="status-pill status-pill--${escapeHTML(monster.status)}">${escapeHTML(formatStatus(monster.status))}</span>`
      : ""}
  </div>`;
}

function renderFighter(side) {
  const monster = activeMonster(side);
