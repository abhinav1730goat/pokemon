          <div class="roster-list">${renderRoster(battle.enemyTeam)}</div>
        </div>
      </div>

      <div class="result-actions">
        <button class="button button-primary" data-rematch>⚔ Battle again</button>
        <button class="button button-quiet" data-edit-team>✎ Edit team</button>
      </div>
