function renderSearchResults() {
  const query = state.search.trim().toLowerCase();
  const queryName = query.replace(/\s+/g, "-");
  const numericQuery = query.replace(/^#/, "").replace(/^0+/, "");
  const chosen = new Set(state.team.map(entry => entry.id));

  const available = state.dex.filter(entry => !chosen.has(entry.id));
  const matches = available.filter(entry => {
    if (!query) return true;
    const nameWithSpaces = entry.name.replace(/-/g, " ");
    const numberMatch = /^\d+$/.test(numericQuery) &&
      String(entry.id).startsWith(numericQuery);
    return entry.name.includes(queryName) ||
      nameWithSpaces.includes(query) ||
      numberMatch;
  }).slice(0, 12);

  const heading = query
    ? `Showing up to ${matches.length} match${matches.length === 1 ? "" : "es"}`
    : `Browse the catalogue (${state.dex.length.toLocaleString()} entries)`;

  if (!matches.length) {
    return `<div class="result-count">${escapeHTML(heading)}</div>
      <div class="result-list"><div class="empty-results">No Pokémon found. Try another name or number.</div></div>`;
  }

  return `<div class="result-count">${escapeHTML(heading)}</div>
    <div class="result-list">
      ${matches.map(entry => `
        <button class="result-card" data-add-id="${entry.id}" ${state.loadingBattle || state.team.length >= 6 ? "disabled" : ""}>
          <span class="result-thumb">${imageMarkup(spriteURL(entry.id), entry.id, formatName(entry.name))}</span>
          <span class="result-copy">
            <strong>${escapeHTML(formatName(entry.name))}</strong>
            <small>${dexNumber(entry.id)} · Add to team</small>
          </span>
        </button>
      `).join("")}
    </div>`;
}

