app.addEventListener("input", event => {
  if (event.target && event.target.id === "pokemon-search") {
    state.search = event.target.value;
    const results = document.getElementById("search-results");
    if (results) results.innerHTML = renderSearchResults();
  }
});

app.addEventListener("click", async event => {
  const button = event.target.closest("button");
  if (!button) return;

  if (button.hasAttribute("data-retry")) {
    loadDex();
    return;
  }

  if (button.hasAttribute("data-add-id")) {
    if (state.loadingBattle || state.team.length >= 6) return;
    const entry = state.dex.find(item => item.id === Number(button.dataset.addId));
    if (entry && !state.team.some(item => item.id === entry.id)) {
      state.team.push(entry);
      state.search = "";
      render();
    }
    return;
  }

  if (button.hasAttribute("data-remove")) {
    if (state.loadingBattle) return;
    state.team.splice(Number(button.dataset.remove), 1);
    render();
    return;
  }

  if (button.hasAttribute("data-random-team")) {
    if (state.loadingBattle) return;
    state.team = shuffle(state.dex).slice(0, 6);
    state.search = "";
    state.setupError = "";
    render();
    return;
  }

  if (button.hasAttribute("data-start")) {
    startBattle();
    return;
  }

  if (button.hasAttribute("data-move")) {
    playerChooseMove(Number(button.dataset.move));
    return;
  }

  if (button.hasAttribute("data-switch")) {
    switchPokemon(Number(button.dataset.switch));
    return;
  }

  if (button.hasAttribute("data-back-team") || button.hasAttribute("data-edit-team")) {
    if (state.battle?.busy) return;
    state.battle = null;
    state.screen = "setup";
    state.setupError = "";
    render();
    return;
  }

  if (button.hasAttribute("data-rematch")) {
    startBattle();
  }
});

render();
loadDex();
</script>
</body>
</html>
