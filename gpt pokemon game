Save this as **`pokemon-arena.html`** and open it in a browser. It needs an internet connection to load the PokéAPI catalogue and Pokémon artwork. You can search the available Pokémon and forms, choose six, and battle with familiar moves, type matchups, status effects, and animations.

```html
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pokémon Team Arena</title>
<style>
  :root {
    --ink: #202743;
    --muted: #73809b;
    --paper: #f4f6fc;
    --panel: #ffffff;
    --line: #e5e9f3;
    --purple: #6656e8;
    --purple-dark: #4e41c6;
    --yellow: #ffd565;
    --shadow: 0 16px 45px rgba(35, 44, 85, .09);
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    min-height: 100vh;
    color: var(--ink);
    font-family: Inter, ui-rounded, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background:
      radial-gradient(circle at 8% 0%, rgba(119, 103, 255, .13), transparent 27rem),
      radial-gradient(circle at 92% 5%, rgba(255, 213, 101, .19), transparent 24rem),
      var(--paper);
  }

  button, input { font: inherit; }
  button { color: inherit; }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 18px clamp(16px, 4vw, 48px);
    border-bottom: 1px solid rgba(222, 227, 240, .85);
    background: rgba(255, 255, 255, .78);
    backdrop-filter: blur(12px);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 13px;
    min-width: 0;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    flex: 0 0 auto;
    border-radius: 16px;
    color: #fff;
    font-size: 25px;
    background: linear-gradient(145deg, #8171ff, #5746df);
    box-shadow: 0 8px 18px rgba(102, 86, 232, .25);
  }

  .brand h1 {
    margin: 0;
    font-size: 17px;
    line-height: 1.2;
    letter-spacing: .06em;
  }

  .brand h1 span { color: var(--purple); }

  .brand p {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 12px;
  }

  .catalog-chip {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 13px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: #5e6882;
    background: #fff;
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
  }

  .catalog-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #48c997;
    box-shadow: 0 0 0 4px rgba(72, 201, 151, .13);
  }

  .page {
    width: min(1200px, 100%);
    margin: 0 auto;
    padding: 28px 22px 58px;
  }

  .page-heading {
    margin: 0 0 22px;
  }

  .eyebrow {
    margin: 0 0 8px;
    color: var(--purple);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  .page-heading h2,
  .section-heading h2 {
    margin: 0;
    font-size: clamp(26px, 4vw, 36px);
    letter-spacing: -.04em;
  }

  .page-heading p,
  .section-heading p {
    max-width: 700px;
    margin: 8px 0 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .builder-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr);
    gap: 18px;
    align-items: start;
  }

  .panel {
    min-width: 0;
    padding: 21px;
    border: 1px solid rgba(225, 229, 241, .95);
    border-radius: 23px;
    background: rgba(255, 255, 255, .94);
    box-shadow: var(--shadow);
  }

  .panel-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 16px;
  }

  .panel-heading h3 {
    margin: 0;
    font-size: 18px;
    letter-spacing: -.02em;
  }

  .panel-heading p {
    margin: 5px 0 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
  }

  .entry-count, .team-count {
    padding: 7px 10px;
    border-radius: 999px;
    color: #5b51c9;
    background: #f0eeff;
    font-size: 11px;
    font-weight: 800;
    white-space: nowrap;
  }

  .search-wrap {
    position: relative;
    margin-bottom: 12px;
  }

  .search-icon {
    position: absolute;
    top: 50%;
    left: 14px;
    transform: translateY(-50%);
    color: #939bb0;
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    height: 48px;
    padding: 0 14px 0 42px;
    border: 1px solid #dfe4f0;
    border-radius: 14px;
    outline: none;
    background: #fbfcff;
    transition: border-color .16s, box-shadow .16s;
  }

  .search-input:focus {
    border-color: #988eff;
    box-shadow: 0 0 0 4px rgba(102, 86, 232, .11);
  }

  .result-count {
    margin: 0 2px 9px;
    color: var(--muted);
    font-size: 11px;
    font-weight: 700;
  }

  .result-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    max-height: 418px;
    overflow: auto;
    padding-right: 3px;
  }

  .result-card {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    padding: 8px 10px;
    border: 1px solid #e9ecf4;
    border-radius: 14px;
    text-align: left;
    background: #fff;
    cursor: pointer;
    transition: transform .15s, border-color .15s, background .15s;
  }

  .result-card:hover:not(:disabled) {
    transform: translateY(-2px);
    border-color: #b8b0ff;
    background: #fbfaff;
  }

  .result-card:disabled {
    opacity: .55;
    cursor: not-allowed;
  }

  .result-thumb {
    display: grid;
    place-items: center;
    width: 43px;
    height: 43px;
    flex: 0 0 auto;
    border-radius: 13px;
    background: #f2f4fb;
  }

  .result-thumb img {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  .result-copy {
    min-width: 0;
  }

  .result-copy strong {
    display: block;
    overflow: hidden;
    font-size: 12px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .result-copy small {
    display: block;
    margin-top: 3px;
    color: #929ab0;
    font-size: 10px;
  }

  .empty-results {
    grid-column: 1 / -1;
    padding: 25px 12px;
    border: 1px dashed #dfe3ee;
    border-radius: 14px;
    color: var(--muted);
    text-align: center;
    font-size: 13px;
  }

  .team-slots {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 9px;
  }

  .team-slot {
    position: relative;
    display: flex;
    align-items: center;
    min-width: 0;
    min-height: 76px;
    gap: 10px;
    padding: 10px;
    border: 1px solid #e8ebf4;
    border-radius: 15px;
    background: #fcfcff;
  }

  .team-slot.empty {
    justify-content: center;
    border-style: dashed;
    color: #a0a8ba;
    background: #fbfcff;
  }

  .empty-slot-mark {
    display: grid;
    place-items: center;
    width: 31px;
    height: 31px;
    border: 1px dashed #c8cedd;
    border-radius: 50%;
    font-size: 17px;
  }

  .empty-slot-text {
    font-size: 11px;
    font-weight: 700;
  }

  .team-avatar {
    display: grid;
    place-items: center;
    width: 49px;
    height: 49px;
    flex: 0 0 auto;
    border-radius: 14px;
    background: #f0f2fa;
  }

  .team-avatar img {
    width: 46px;
    height: 46px;
    object-fit: contain;
  }

  .team-copy {
    min-width: 0;
    padding-right: 20px;
  }

  .team-copy small, .team-copy strong {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .team-copy small {
    color: #999fb1;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .team-copy strong {
    margin-top: 3px;
    font-size: 12px;
  }

  .remove-slot {
    position: absolute;
    top: 7px;
    right: 7px;
    display: grid;
    place-items: center;
    width: 23px;
    height: 23px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    color: #8c94a8;
    background: #f1f2f7;
    cursor: pointer;
    font-size: 15px;
  }

  .remove-slot:hover:not(:disabled) {
    color: #ca4b61;
    background: #fff0f2;
  }

  .team-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 16px;
    padding-top: 15px;
    border-top: 1px solid #edf0f6;
  }

  .team-hint {
    color: var(--muted);
    font-size: 11px;
    line-height: 1.4;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 42px;
    padding: 0 15px;
    border: 1px solid transparent;
    border-radius: 13px;
    font-weight: 800;
    cursor: pointer;
    transition: transform .15s, background .15s, box-shadow .15s;
  }

  .button:hover:not(:disabled) { transform: translateY(-1px); }
  .button:disabled { opacity: .48; cursor: not-allowed; }

  .button-primary {
    color: #fff;
    background: linear-gradient(135deg, #7564f5, #5848d7);
    box-shadow: 0 8px 18px rgba(102, 86, 232, .2);
  }

  .button-primary:hover:not(:disabled) {
    background: linear-gradient(135deg, #6655e9, #493bbf);
  }

  .button-soft {
    color: #6055cf;
    border-color: #e3e0ff;
    background: #f6f4ff;
  }

  .button-quiet {
    color: #626d87;
    border-color: #e4e8f1;
    background: #fff;
  }

  .setup-error {
    margin: 13px 0 0;
    color: #b74352;
    font-size: 12px;
  }

  .fine-print {
    margin: 14px 2px 0;
    color: #929bb0;
    font-size: 11px;
    line-height: 1.5;
  }

  /* Battle screen */
  .battle-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 17px;
  }

  .battle-heading h2 {
    margin: 0;
    font-size: clamp(23px, 4vw, 32px);
    letter-spacing: -.04em;
  }

  .battle-heading p {
    margin: 5px 0 0;
    color: var(--muted);
    font-size: 13px;
  }

  .arena {
    position: relative;
    height: 430px;
    overflow: hidden;
    border: 1px solid rgba(188, 204, 227, .7);
    border-radius: 26px;
    background: linear-gradient(180deg, #dff2ff 0%, #eef8ff 53%, #dcefd5 54%, #b7d998 100%);
    box-shadow: 0 18px 42px rgba(45, 77, 122, .12);
    isolation: isolate;
  }

  .arena::before {
    position: absolute;
    top: 34px;
    right: 18%;
    width: 104px;
    height: 104px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 232, 150, .95), rgba(255, 226, 140, .14) 72%);
    content: "";
  }

  .arena-ground {
    position: absolute;
    z-index: -1;
    right: -8%;
    bottom: -60px;
    left: -8%;
    height: 190px;
    border-radius: 50% 50% 0 0 / 28% 28% 0 0;
    background: linear-gradient(180deg, #c7e4a3, #91c275);
  }

  .arena-hill {
    position: absolute;
    z-index: -2;
    bottom: 90px;
    width: 48%;
    height: 110px;
    border-radius: 50% 50% 0 0;
    background: rgba(135, 194, 121, .38);
  }

  .arena-hill.left { left: -13%; }
  .arena-hill.right { right: -12%; height: 145px; }

  .arena-ring {
    position: absolute;
    z-index: -1;
    width: 265px;
    height: 74px;
    border: 2px solid rgba(80, 148, 94, .3);
    border-radius: 50%;
    background: rgba(255, 255, 255, .13);
  }

  .arena-ring.enemy { top: 31%; right: 12%; }
  .arena-ring.player { bottom: 9%; left: 9%; width: 315px; height: 87px; }

  .arena-stamp {
    position: absolute;
    z-index: 3;
    padding: 6px 10px;
    border: 1px solid rgba(255,255,255,.75);
    border-radius: 999px;
    background: rgba(255,255,255,.72);
    color: #64718a;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: .13em;
    backdrop-filter: blur(7px);
  }

  .arena-stamp--enemy { top: 15px; right: 16px; }
  .arena-stamp--player { bottom: 14px; left: 16px; }

  .versus-mark {
    position: absolute;
    z-index: 1;
    top: 48%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    transform: translate(-50%, -50%) rotate(-8deg);
    border: 2px solid rgba(255,255,255,.9);
    border-radius: 14px;
    color: white;
    background: rgba(102, 86, 232, .7);
    box-shadow: 0 5px 15px rgba(72, 72, 131, .18);
    font-size: 12px;
    font-weight: 1000;
  }

  .fighter {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .fighter--enemy { top: 8%; right: 5%; }
  .fighter--player {
    bottom: 2%;
    left: 3%;
    flex-direction: row-reverse;
  }

  .fighter-art {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(155px, 19vw, 225px);
    aspect-ratio: 1;
    flex: 0 0 auto;
  }

  .fighter-art img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 12px 8px rgba(44, 68, 76, .24));
  }

  .fighter-art.is-attacking img {
    animation: lunge .48s ease-in-out;
  }

  .fighter-art.is-hit img {
    animation: hit-shake .52s ease-in-out;
  }

  .impact {
    position: absolute;
    z-index: 2;
    width: 42%;
    height: 42%;
    border: 5px solid var(--impact-color, #fff);
    border-radius: 48% 52% 44% 56%;
    opacity: 0;
    box-shadow: 0 0 20px var(--impact-color, #fff), inset 0 0 14px var(--impact-color, #fff);
    pointer-events: none;
    animation: impact-burst .52s ease-out forwards;
  }

  .pokemon-panel {
    width: 220px;
    padding: 12px 14px 11px;
    border: 1px solid rgba(255,255,255,.85);
    border-radius: 16px;
    background: rgba(255, 255, 255, .92);
    box-shadow: 0 8px 23px rgba(42, 61, 80, .12);
    backdrop-filter: blur(8px);
  }

  .mon-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
  }

  .mon-title strong {
    overflow: hidden;
    font-size: 14px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .level {
    flex: 0 0 auto;
    color: #8b94a9;
    font-size: 10px;
    font-weight: 800;
  }

  .type-row {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 6px 0 9px;
  }

  .type-pill {
    display: inline-flex;
    align-items: center;
    min-height: 18px;
    padding: 2px 7px;
    border-radius: 999px;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: .03em;
  }

  .hp-track {
    height: 7px;
    overflow: hidden;
    border-radius: 999px;
    background: #e8ebf1;
  }

  .hp-fill {
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #47c895, #75d98c);
    transition: width .35s ease;
  }

  .hp-fill--mid { background: linear-gradient(90deg, #f0c644, #f4a949); }
  .hp-fill--low { background: linear-gradient(90deg, #ef7376, #df4f65); }

  .hp-caption {
    display: flex;
    justify-content: space-between;
    margin-top: 5px;
    color: #7c879f;
    font-size: 9px;
    font-weight: 800;
  }

  .status-pill {
    display: inline-flex;
    margin-top: 7px;
    padding: 3px 7px;
    border-radius: 999px;
    color: #fff;
    background: #7e6bdc;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: .08em;
  }

  .status-pill--burn { background: #e97846; }
  .status-pill--poison { background: #9a61c2; }
  .status-pill--paralysis { background: #c39b22; }
  .status-pill--freeze { background: #4a9cc0; }

  .battle-console {
    display: grid;
    grid-template-columns: minmax(0, .86fr) minmax(0, 1.14fr);
    gap: 16px;
    margin-top: 16px;
  }

  .console-panel {
    min-width: 0;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 21px;
    background: #fff;
    box-shadow: var(--shadow);
  }

  .console-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 11px;
  }

  .console-title h3 {
    margin: 0;
    font-size: 15px;
  }

  .turn-indicator {
    padding: 6px 9px;
    border-radius: 999px;
    color: #6255d1;
    background: #f1efff;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .battle-log {
    display: flex;
    flex-direction: column;
    gap: 7px;
    min-height: 92px;
  }

  .log-line {
    margin: 0;
    color: #8791a7;
    font-size: 12px;
    line-height: 1.45;
  }

  .log-line.latest {
    color: #303a56;
    font-weight: 800;
  }

  .battle-tip {
    margin: 13px 0 0;
    padding-top: 11px;
    border-top: 1px solid #edf0f5;
    color: #8b94a8;
    font-size: 10px;
    line-height: 1.5;
  }

  .move-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .move-button {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-height: 62px;
    overflow: hidden;
    padding: 9px 11px 9px 14px;
    border: 1px solid #e8ebf2;
    border-radius: 14px;
    text-align: left;
    background: #fff;
    cursor: pointer;
    transition: transform .14s, border-color .14s, background .14s;
  }

  .move-button::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 4px;
    background: var(--move-color, #888);
    content: "";
  }

  .move-button:hover:not(:disabled) {
    transform: translateY(-2px);
    border-color: var(--move-color, #bbb);
    background: #fcfcff;
  }

  .move-button:disabled { opacity: .54; cursor: not-allowed; }

  .move-copy { min-width: 0; }

  .move-copy strong {
    display: block;
    overflow: hidden;
    font-size: 11px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .move-copy small {
    display: block;
    margin-top: 4px;
    color: #929bb0;
    font-size: 9px;
    font-weight: 700;
  }

  .move-power {
    display: grid;
    place-items: center;
    min-width: 32px;
    height: 28px;
    padding: 0 5px;
    border-radius: 9px;
    color: #66708a;
    background: #f2f4f8;
    font-size: 10px;
    font-weight: 900;
  }

  .switch-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 15px 0 8px;
    color: #6e7890;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .switch-list {
    display: flex;
    gap: 7px;
    overflow-x: auto;
    padding: 2px 1px 4px;
  }

  .switch-chip {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    padding: 5px 8px 5px 5px;
    border: 1px solid #e8ebf2;
    border-radius: 12px;
    background: #fff;
    cursor: pointer;
    white-space: nowrap;
  }

  .switch-chip:hover:not(:disabled) {
    border-color: #bbb3ff;
    background: #faf9ff;
  }

  .switch-chip:disabled { opacity: .43; cursor: not-allowed; }

  .switch-chip img {
    width: 28px;
    height: 28px;
    object-fit: contain;
  }

  .switch-chip span {
    max-width: 91px;
    overflow: hidden;
    font-size: 9px;
    font-weight: 800;
    text-overflow: ellipsis;
  }

  /* Results / loading */
  .result-wrap, .center-state {
    width: min(760px, 100%);
    margin: 20px auto;
    padding: 30px;
    border: 1px solid var(--line);
    border-radius: 26px;
    background: #fff;
    box-shadow: var(--shadow);
    text-align: center;
  }

  .result-icon {
    display: grid;
    place-items: center;
    width: 78px;
    height: 78px;
    margin: 0 auto 14px;
    border: 1px solid #e9e4ff;
    border-radius: 25px;
    background: #f3f0ff;
