function getPokemonImage(data) {
  return data.sprites?.other?.["official-artwork"]?.front_default ||
    data.sprites?.other?.home?.front_default ||
    data.sprites?.front_default ||
    spriteURL(data.id);
}

function moveSlug(name) {
  return String(name).toLowerCase()
    .replace(/[’']/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
}

function shuffle(array) {
  const result = [...array];
  for (let i = result.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [result[i], result[j]] = [result[j], result[i]];
  }
  return result;
}

function randomItem(array) {
  return array[Math.floor(Math.random() * array.length)];
}

function buildMoves(data, types) {
  const typeMoves = types.flatMap(type => MOVE_BANK[type] || []);
  const neutralMoves = types.includes("normal") ? [] : MOVE_BANK.normal;
  const allMoves = [...typeMoves, ...neutralMoves];
  if (!allMoves.length) allMoves.push(...MOVE_BANK.normal);

  const learnedNames = new Set((data.moves || []).map(item => item.move.name));
  const learnedPool = allMoves.filter(move => learnedNames.has(moveSlug(move.name)));

  let pool = learnedPool.length >= 4
    ? learnedPool
    : [...learnedPool, ...allMoves.filter(move => !learnedPool.some(known => known.name === move.name))];

  const unique = new Map(pool.map(move => [move.name, move]));
  pool = [...unique.values()];

  const selected = [];

  // Try to give the Pokémon a move matching each of its types.
  for (const type of types) {
    if (selected.length >= 4) break;
    const options = pool.filter(move =>
      move.type === type && !selected.some(chosen => chosen.name === move.name)
    );
    if (options.length) selected.push(randomItem(options));
  }

  for (const move of shuffle(pool)) {
    if (selected.length >= 4) break;
    if (!selected.some(chosen => chosen.name === move.name)) selected.push(move);
  }

  for (const move of shuffle(allMoves)) {
    if (selected.length >= 4) break;
    if (!selected.some(chosen => chosen.name === move.name)) selected.push(move);
  }

  return selected.slice(0, 4).map(move => ({
    ...move,
    effect: move.effect ? { ...move.effect } : null
  }));
}

function statAtLevel50(base, isHP = false) {
  return isHP
    ? Math.floor(((2 * base + 31) * LEVEL) / 100) + LEVEL + 10
    : Math.floor(((2 * base + 31) * LEVEL) / 100) + 5;
}

function makeBattler(data) {
  const types = (data.types || [])
    .slice()
    .sort((a, b) => a.slot - b.slot)
    .map(item => item.type.name);

  if (!types.length) types.push("normal");

  const base = name => data.stats?.find(item => item.stat.name === name)?.base_stat || 60;
  const maxHp = statAtLevel50(base("hp"), true);

  return {
    id: data.id,
    name: data.name,
    image: getPokemonImage(data),
    types,
    level: LEVEL,
    stats: {
      hp: maxHp,
      attack: statAtLevel50(base("attack")),
      defense: statAtLevel50(base("defense")),
      "special-attack": statAtLevel50(base("special-attack")),
      "special-defense": statAtLevel50(base("special-defense")),
      speed: statAtLevel50(base("speed"))
    },
    maxHp,
    hp: maxHp,
    status: null,
    moves: buildMoves(data, types)
  };
}

async function fetchJSON(url) {
  const response = await fetch(url);
  if (!response.ok) throw new Error(`Request failed (${response.status})`);
  return response.json();
}

async function loadDex() {
  state.loadingDex = true;
  state.dexError = "";
  render();

  try {
    let next = `${API}/pokemon?limit=2000`;
    const rows = [];

    while (next) {
      const result = await fetchJSON(next);
      rows.push(...result.results);
      next = result.next;
    }

    const entries = new Map();
    for (const row of rows) {
      const match = row.url.match(/\/pokemon\/(\d+)\/?$/);
      if (!match) continue;
      const id = Number(match[1]);
      if (!entries.has(id)) entries.set(id, { id, name: row.name, url: row.url });
    }

    state.dex = [...entries.values()].sort((a, b) => a.id - b.id);
    if (!state.dex.length) throw new Error("No catalogue entries returned.");

    state.loadingDex = false;
    state.dexError = "";
    render();
  } catch (error) {
    state.loadingDex = false;
    state.dexError = "Check your internet connection, then try loading the Pokédex again.";
    render();
  }
}

function getPokemonDetails(entry) {
  const url = entry.url || `${API}/pokemon/${entry.id}/`;

  if (!detailCache.has(url)) {
    const request = fetchJSON(url).catch(error => {
      detailCache.delete(url);
      throw error;
    });
    detailCache.set(url, request);
  }

  return detailCache.get(url);
}

function effectiveness(moveType, defenderTypes) {
  const chart = TYPE_CHART[moveType];
  if (!chart) return 1;

  let result = 1;
  for (const defenderType of defenderTypes) {
    if (chart.immune.includes(defenderType)) return 0;
    if (chart.super.includes(defenderType)) result *= 2;
    if (chart.resist.includes(defenderType)) result *= .5;
  }
  return result;
}

function formatStatus(status) {
  return ({
    burn: "BURN",
    poison: "POISON",
    paralysis: "PARA",
    freeze: "FROZEN"
  })[status] || String(status || "").toUpperCase();
}

function addLog(message) {
  if (!state.battle) return;
  state.battle.logs.push(message);
  if (state.battle.logs.length > 9) state.battle.logs.shift();
}

function activeMonster(side) {
  const battle = state.battle;
  if (!battle) return null;
  return side === "player"
    ? battle.playerTeam[battle.playerIndex]
    : battle.enemyTeam[battle.enemyIndex];
}

function isStatusImmune(monster, status) {
  const immunities = {
    burn: ["fire"],
    poison: ["poison", "steel"],
    paralysis: ["electric"],
    freeze: ["ice"]
  };
  return (immunities[status] || []).some(type => monster.types.includes(type));
}

function canMove(monster) {
  if (monster.status === "paralysis" && Math.random() < .25) {
    addLog(`${formatName(monster.name)} is paralyzed and can't move!`);
    return false;
  }

  if (monster.status === "freeze") {
    if (Math.random() < .2) {
      monster.status = null;
      addLog(`${formatName(monster.name)} thawed out!`);
    } else {
      addLog(`${formatName(monster.name)} is frozen solid!`);
      return false;
    }
  }

  return true;
}

function applyResidualDamage(monster) {
  if (monster.hp <= 0) return;

  if (monster.status === "burn" || monster.status === "poison") {
    const fraction = monster.status === "burn" ? 16 : 8;
    const damage = Math.max(1, Math.floor(monster.maxHp / fraction));
    monster.hp = Math.max(0, monster.hp - damage);
    addLog(`${formatName(monster.name)} is hurt by ${monster.status} (-${damage} HP).`);
  }
}

function tryMoveEffect(target, move) {
  if (!move.effect || target.hp <= 0 || target.status) return;
  if (isStatusImmune(target, move.effect.status)) return;
  if (Math.random() >= move.effect.chance) return;

  target.status = move.effect.status;
  const pastTense = {
    burn: "was burned",
    poison: "was poisoned",
    paralysis: "was paralyzed",
    freeze: "was frozen"
  }[target.status] || `was affected by ${target.status}`;

  addLog(`${formatName(target.name)} ${pastTense}!`);
}

function resolveMove(attacker, defender, move) {
  addLog(`${formatName(attacker.name)} used ${move.name}!`);

  if (!canMove(attacker)) {
    applyResidualDamage(attacker);
    return;
  }

  if (Math.random() * 100 > move.accuracy) {
    addLog(`${formatName(attacker.name)}'s attack missed!`);
    applyResidualDamage(attacker);
    return;
  }

  const multiplier = effectiveness(move.type, defender.types);

  if (multiplier === 0) {
    addLog(`It had no effect on ${formatName(defender.name)}!`);
  } else {
    const attackStat = move.category === "Special"
      ? attacker.stats["special-attack"]
      : attacker.stats.attack;
    const defenseStat = move.category === "Special"
      ? defender.stats["special-defense"]
      : defender.stats.defense;

    const baseDamage = Math.floor(
      ((2 * LEVEL / 5 + 2) * move.power * attackStat / Math.max(1, defenseStat)) / 50
    ) + 2;

    const stab = attacker.types.includes(move.type) ? 1.5 : 1;
    const critical = Math.random() < .0625;
    const randomFactor = .85 + Math.random() * .15;
    const damage = Math.max(1, Math.floor(
      baseDamage * stab * multiplier * (critical ? 1.5 : 1) * randomFactor
    ));

    defender.hp = Math.max(0, defender.hp - damage);
    addLog(`${formatName(defender.name)} took ${damage} damage${critical ? " — critical hit!" : ""}`);

    if (multiplier >= 2) addLog("It's super effective!");
    else if (multiplier <= .5) addLog("It's not very effective…");

    if (defender.hp > 0) tryMoveEffect(defender, move);
  }

  applyResidualDamage(attacker);
}

async function animateAndResolve(side, move) {
  const battle = state.battle;
  const attacker = activeMonster(side);
  const defender = activeMonster(side === "player" ? "enemy" : "player");

  battle.animation = { actor: side, type: move.type };
  render();
  await new Promise(resolve => setTimeout(resolve, 540));

  resolveMove(attacker, defender, move);
  battle.animation = null;
  render();
}

function handleFaints() {
  const battle = state.battle;
  const result = { over: false, playerChanged: false, enemyChanged: false };

  for (const side of ["player", "enemy"]) {
    const team = side === "player" ? battle.playerTeam : battle.enemyTeam;
    const indexKey = side === "player" ? "playerIndex" : "enemyIndex";
    const active = team[battle[indexKey]];

    if (!active || active.hp > 0) continue;

    addLog(`${formatName(active.name)} fainted!`);

    const nextIndex = team.findIndex((monster, index) =>
      index !== battle[indexKey] && monster.hp > 0
    );

    if (nextIndex < 0) {
      battle.winner = side === "player" ? "enemy" : "player";
      addLog(battle.winner === "player"
        ? "Your team wins the battle!"
        : "Your team has no Pokémon left!");
      state.screen = "result";
      state.loadingBattle = false;
      result.over = true;
      return result;
    }

    battle[indexKey] = nextIndex;
    if (side === "player") result.playerChanged = true;
    else result.enemyChanged = true;

    const nextMonster = team[nextIndex];
    addLog(side === "player"
      ? `Go, ${formatName(nextMonster.name)}!`
      : `The rival sent out ${formatName(nextMonster.name)}!`);
  }

  return result;
}

function chooseEnemyMove() {
  const enemy = activeMonster("enemy");
  const player = activeMonster("player");

  const ranked = enemy.moves.map(move => {
    const multiplier = effectiveness(move.type, player.types);
    const stab = enemy.types.includes(move.type) ? 1.5 : 1;
    return {
      move,
      score: (multiplier || .1) * move.power * stab * (move.accuracy / 100)
    };
  }).sort((a, b) => b.score - a.score);

  const bestOptions = ranked.slice(0, Math.min(3, ranked.length));
  return randomItem(bestOptions).move;
}

async function takeEnemyTurn() {
  if (!state.battle || state.screen !== "battle") return;

  const move = chooseEnemyMove();
  await animateAndResolve("enemy", move);
  handleFaints();
}

async function playerChooseMove(index) {
  const battle = state.battle;
  if (!battle || battle.busy || state.screen !== "battle") return;

  const attacker = activeMonster("player");
  const move = attacker.moves[index];
  if (!move) return;

  battle.busy = true;
  render();

  const enemyAtStart = activeMonster("enemy");
  await animateAndResolve("player", move);

  const enemyWasKnockedOut = enemyAtStart.hp <= 0;
  const outcome = handleFaints();

  if (outcome.over) {
    battle.busy = false;
    render();
    return;
  }

  // A rival sends out the next Pokémon after a knockout; it doesn't attack immediately.
  if (enemyWasKnockedOut) {
    battle.busy = false;
    render();
    return;
  }

  await new Promise(resolve => setTimeout(resolve, 300));
  if (state.screen === "battle") await takeEnemyTurn();

  battle.busy = false;
  render();
}

async function switchPokemon(index) {
  const battle = state.battle;
  if (!battle || battle.busy || state.screen !== "battle") return;
  if (index === battle.playerIndex) return;

  const next = battle.playerTeam[index];
  if (!next || next.hp <= 0) return;

  battle.busy = true;
  const previous = activeMonster("player");
  addLog(`Come back, ${formatName(previous.name)}!`);
  battle.playerIndex = index;
  addLog(`Go, ${formatName(next.name)}!`);
  render();

  await new Promise(resolve => setTimeout(resolve, 350));
  if (state.screen === "battle") await takeEnemyTurn();

  battle.busy = false;
  render();
}

async function startBattle() {
  if (state.loadingBattle || state.team.length !== 6) return;

  const chosenEntries = [...state.team];
  const chosenIds = new Set(chosenEntries.map(entry => entry.id));
  const possibleRivals = state.dex.filter(entry => !chosenIds.has(entry.id));
  const rivalEntries = shuffle(possibleRivals).slice(0, 6);

  if (rivalEntries.length < 6) {
    state.setupError = "There aren't enough catalogue entries to make a rival team.";
    render();
    return;
  }

  state.screen = "setup";
  state.loadingBattle = true;
  state.setupError = "";
  render();

  try {
    const [playerData, enemyData] = await Promise.all([
      Promise.all(chosenEntries.map(getPokemonDetails)),
      Promise.all(rivalEntries.map(getPokemonDetails))
    ]);

    state.battle = {
      playerTeam: playerData.map(makeBattler),
      enemyTeam: enemyData.map(makeBattler),
      playerIndex: 0,
      enemyIndex: 0,
      busy: false,
      animation: null,
      winner: null,
      logs: []
    };

    state.screen = "battle";
    state.loadingBattle = false;
    addLog("A rival trainer challenges you!");
    addLog(`Go, ${formatName(activeMonster("player").name)}!`);
    addLog(`The rival sent out ${formatName(activeMonster("enemy").name)}!`);
    render();
  } catch (error) {
    state.loadingBattle = false;
    state.screen = "setup";
    state.setupError = "The battle team couldn't be loaded. Check your connection and try again.";
    render();
  }
}

function renderTypePills(types) {
  return types.map(type =>
    `<span class="type-pill type-${escapeHTML(type)}">${escapeHTML(formatName(type))}</span>`
  ).join("");
}

function hpPercent(monster) {
  return Math.max(0, Math.min(100, Math.round((Math.max(0, monster.hp) / monster.maxHp) * 100)));
}

function renderPokemonPanel(monster) {
  const percent = hpPercent(monster);
  const hpClass = percent <= 20 ? "hp-fill--low" : percent <= 50 ? "hp-fill--mid" : "";

  return `<div class="pokemon-panel">
    <div class="mon-title">
      <strong>${escapeHTML(formatName(monster.name))}</strong>
      <span class="level">Lv. ${monster.level}</span>
    </div>
    <div class="type-row">${renderTypePills(monster.types)}</div>
    <div class="hp-track"><div class="hp-fill ${hpClass}" style="width:${percent}%"></div></div>
